---
const { lang = "es" } = Astro.props;
const locales = {
  es: { label: "ES", href: "/", name: "Español" },
  en: { label: "EN", href: "/en/", name: "English" },
};
---

<div class="flex items-center gap-1">
  {Object.values(locales).map((l) => (
    <a
      href={l.href}
      class={`rounded px-2 py-1 text-xs font-semibold uppercase tracking-wider transition-colors ${
        lang === l.label.toLowerCase()
          ? "bg-amber-500/20 text-amber-400"
          : "text-neutral-500 hover:text-neutral-300"
      }`}
      aria-label={l.name}
    >
      {l.label}
    </a>
  ))}
</div>
