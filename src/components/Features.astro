---
import { Icon } from "astro-icon/components";
import { es } from "../i18n";

const { t = es } = Astro.props;
---

<section id="features" class="bg-neutral-900 px-4 py-24">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center font-medieval text-3xl text-amber-400 md:text-4xl">{t.features.title}</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.features.items.map((item, i) => {
        const delay = Math.min(i + 1, 5);
        return (
        <div class={`rounded-lg border border-neutral-800 bg-neutral-950 p-6 reveal reveal-delay-${delay} transition-all duration-300 hover:-translate-y-1 hover:border-amber-500 hover:shadow-lg hover:shadow-amber-500/10`}>
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/10">
            <Icon name={item.icon} class="h-5 w-5 text-amber-400" />
          </div>
          <h3 class="mt-3 font-bold text-white">{item.title}</h3>
          <p class="mt-2 text-sm text-neutral-400">{item.text}</p>
        </div>
      );})}
    </div>
  </div>
</section>
