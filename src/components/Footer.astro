---
import { es } from "../i18n";

const { t = es } = Astro.props;
---

<footer id="footer" class="border-t border-neutral-800 bg-neutral-950 px-4 py-12 transition-all duration-500">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row reveal">
      <div class="text-center sm:text-left">
        <a href="/" class="font-medieval text-lg tracking-wider text-amber-400 hover:text-amber-300 transition-colors">Battle For Embolia</a>
        <p class="mt-1 text-xs text-neutral-600">
          {t.footer.tagline}
        </p>
      </div>
      <div data-footer-buttons class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-5 py-2.5 text-sm font-bold text-neutral-950 transition-all duration-300 hover:bg-amber-400 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/25"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          {t.footer.wishlist}
        </a>
        <a
          href="https://agerarg.itch.io/battle-for-embolia"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-neutral-700 px-5 py-2.5 text-sm font-semibold text-neutral-300 transition-all duration-300 hover:border-amber-500 hover:text-amber-400 hover:-translate-y-0.5"
        >
          {t.footer.itch}
        </a>
      </div>
      <div data-footer-post class="hidden flex-wrap items-center justify-center gap-3">
        <a
          href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-amber-500 px-5 py-2.5 text-sm font-bold text-neutral-950 transition-all duration-300 hover:bg-amber-400 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/25"
        >
          {t.footer.steam}
        </a>
        <a
          href="https://agerarg.itch.io/battle-for-embolia"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-neutral-700 px-5 py-2.5 text-sm font-semibold text-neutral-300 transition-all duration-300 hover:border-amber-500 hover:text-amber-400 hover:-translate-y-0.5"
        >
          {t.footer.itch}
        </a>
      </div>
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-6 text-xs text-neutral-600 reveal reveal-delay-1">
      {t.footer.links.map((link) => (
        <a href={link.href} class="hover:text-amber-400 transition-colors duration-200">{link.label}</a>
      ))}
    </div>
    <div class="mt-8 text-center text-xs text-neutral-500 reveal reveal-delay-2">
      {t.footer.copyright}<br />
      {t.footer.powered} <a href="https://agergames.com.ar" class="underline hover:text-amber-400 transition-colors duration-200">AgerGames.com.ar</a>
    </div>
  </div>
</footer>
