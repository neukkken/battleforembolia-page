---
import LangSwitcher from "./LangSwitcher.astro";
import { es } from "../i18n";

const { lang = "es", t = es } = Astro.props;
---

<header aria-label="Encabezado del sitio" class="fixed top-0 left-0 right-0 z-50 bg-neutral-950/60 backdrop-blur-md border-b border-transparent transition-all duration-300 scrolled:bg-neutral-950/90 scrolled:border-neutral-800">
  <nav aria-label="Navegación principal" class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={lang === "en" ? "/en/" : "/"} class="font-medieval text-lg tracking-wider text-amber-400 hover:text-amber-300 transition-colors">
      BFE
    </a>
    <button data-menu-toggle class="group md:hidden rounded p-2 text-neutral-300 hover:text-amber-400 transition-colors relative z-50" aria-label={t.menuOpen} aria-expanded="false" data-label-open={t.menuOpen} data-label-close={t.menuClose}>
      <svg class="h-6 w-6 overflow-visible" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path class="line-top transition-all duration-300 ease-in-out" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16" />
        <path class="line-middle transition-all duration-300 ease-in-out" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16" />
        <path class="line-bottom transition-all duration-300 ease-in-out" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16" />
      </svg>
    </button>
    <ul data-menu class="md:flex items-center gap-6 text-sm font-medium text-neutral-300 max-md:fixed max-md:inset-0 max-md:z-40 max-md:flex max-md:flex-col max-md:items-center max-md:justify-center max-md:gap-10 max-md:bg-neutral-950/95 max-md:backdrop-blur-lg max-md:transition-all max-md:duration-300 max-md:ease-in-out max-md:opacity-0 max-md:invisible max-md:scale-95" aria-label="Secciones de la página">
      {t.header.links.map((link) => (
        <li>
          <a href={link.href} class="hover:text-amber-400 transition-colors max-md:text-2xl max-md:font-semibold">
            {link.label}
          </a>
        </li>
      ))}
      <li class="md:hidden">
        <LangSwitcher lang={lang} />
      </li>
    </ul>
    <div class="hidden md:flex items-center gap-3">
      <LangSwitcher lang={lang} />
      <a
        href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
        target="_blank"
        rel="noopener noreferrer"
        data-header-cta
        data-text-pre={t.hero.wishlist}
        data-text-post={t.header.cta}
        class="rounded bg-amber-500 px-4 py-2 text-sm font-bold text-neutral-950 hover:bg-amber-400 transition-colors"
      >
        {t.hero.wishlist}
      </a>
    </div>
  </nav>
</header>

<style>
  [data-menu].open {
    opacity: 1 !important;
    visibility: visible !important;
    transform: scale(1) !important;
    pointer-events: auto !important;
  }
  [data-menu-toggle][aria-expanded="true"] .line-top {
    transform: translateY(6px) rotate(45deg);
  }
  [data-menu-toggle][aria-expanded="true"] .line-middle {
    opacity: 0;
  }
  [data-menu-toggle][aria-expanded="true"] .line-bottom {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-menu]");
  const html = document.documentElement;

  if (toggle && menu) {
    const openLabel = toggle.dataset.labelOpen || "Abrir menú";
    const closeLabel = toggle.dataset.labelClose || "Cerrar menú";

    function closeMenu() {
      menu.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", openLabel);
      html.style.overflow = "";
    }

    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
      html.style.overflow = isOpen ? "hidden" : "";
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }

  const navLinks = document.querySelectorAll("nav a[href^='#']");
  const sections = [...navLinks].map((link) => document.getElementById(link.getAttribute("href")?.slice(1) || "")).filter(Boolean);

  const navObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            link.removeAttribute("aria-current");
            if (link.getAttribute("href") === `#${id}`) {
              link.setAttribute("aria-current", "section");
            }
          });
        }
      }
    },
    { threshold: 0.3, rootMargin: "-80px 0px 0px 0px" }
  );

  sections.forEach((s) => s && navObserver.observe(s));
</script>
