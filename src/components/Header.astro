---
import LangSwitcher from "./LangSwitcher.astro";
import { es } from "../i18n";

const { lang = "es", t = es } = Astro.props;
const rootHref = lang === "en" ? "/en/" : "/";
---

<header aria-label="Encabezado del sitio" class="fixed top-0 left-0 right-0 z-50 bg-neutral-950/60 backdrop-blur-md border-b border-transparent transition-all duration-300 scrolled:bg-neutral-950/90 scrolled:border-neutral-800">
  <nav aria-label="Navegación principal" class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={rootHref} class="font-medieval text-lg tracking-wider text-amber-400 hover:text-amber-300 transition-colors">
      BFE
    </a>

    <!-- Desktop nav -->
    <ul class="hidden [900px]:flex items-center gap-6 text-sm font-medium text-neutral-300" aria-label="Secciones de la página">
      {t.header.links.map((link) => (
        <li>
          <a href={link.href} class="hover:text-amber-400 transition-colors">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop right section -->
    <div class="hidden [900px]:flex items-center gap-3">
      <LangSwitcher lang={lang} />
      <a
        href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
        target="_blank"
        rel="noopener noreferrer"
        data-header-cta
        data-text-pre={t.hero.wishlist}
        data-text-post={t.header.cta}
        class="rounded bg-amber-500 px-4 py-2 text-sm font-bold text-neutral-950 hover:bg-amber-400 transition-colors"
      >
        {t.hero.wishlist}
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button data-menu-toggle class="[900px]:hidden rounded p-2 text-neutral-300 hover:text-amber-400 transition-colors relative z-50" aria-label={t.menuOpen} aria-expanded="false" data-label-open={t.menuOpen} data-label-close={t.menuClose}>
      <svg class="h-6 w-6 overflow-visible" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path class="line-top transition-all duration-300 ease-in-out" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16" />
        <path class="line-middle transition-all duration-300 ease-in-out" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16" />
        <path class="line-bottom transition-all duration-300 ease-in-out" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16" />
      </svg>
    </button>
  </nav>
</header>

<!-- Mobile menu backdrop -->
<div data-menu-backdrop class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300 [900px]:hidden" />

<!-- Mobile menu panel -->
<div data-menu class="fixed top-0 right-0 z-50 h-full w-full max-w-sm bg-neutral-950 border-l border-neutral-800 translate-x-full transition-all duration-300 ease-in-out [900px]:hidden flex flex-col">
  <div class="flex items-center justify-between border-b border-neutral-800 px-5 py-4">
    <a href={rootHref} class="font-medieval text-lg tracking-wider text-amber-400">BFE</a>
    <button data-menu-close class="rounded p-2 text-neutral-400 hover:text-amber-400 transition-colors" aria-label={t.menuClose}>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-6" aria-label="Secciones de la página">
    <ul class="flex flex-col gap-1">
      {t.header.links.map((link) => (
        <li>
          <a
            href={link.href}
            class="group relative flex items-center rounded-lg px-4 py-3 text-base font-medium text-neutral-300 transition-all duration-200 hover:bg-neutral-800/60 hover:text-amber-400 aria-current:bg-amber-500/10 aria-current:text-amber-400"
          >
            <span class="absolute left-0 h-0 w-0.5 rounded-r bg-amber-400 transition-all duration-200 group-hover:h-6 aria-current:h-6" />
            <span class="ml-2">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="border-t border-neutral-800 p-5 space-y-3">
    <LangSwitcher lang={lang} />
    <a
      href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 rounded-lg bg-amber-500 px-4 py-3 text-sm font-bold text-neutral-950 transition-all hover:bg-amber-400"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {t.hero.wishlist}
    </a>
  </div>
</div>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-menu]");
  const backdrop = document.querySelector("[data-menu-backdrop]");
  const closeBtn = document.querySelector("[data-menu-close]");
  const topLine = document.querySelector(".line-top");
  const midLine = document.querySelector(".line-middle");
  const botLine = document.querySelector(".line-bottom");
  const html = document.documentElement;

  const MENU_CLOSED = ["max-[900px]:opacity-0", "max-[900px]:invisible", "max-[900px]:translate-x-full"];
  const MENU_OPEN = ["max-[900px]:opacity-100", "max-[900px]:visible", "max-[900px]:translate-x-0"];
  const BACKDROP_CLOSED = ["opacity-0", "invisible"];
  const BACKDROP_OPEN = ["opacity-100", "visible"];

  if (toggle && menu && backdrop && closeBtn) {
    const openLabel = toggle.dataset.labelOpen || "Abrir menú";
    const closeLabel = toggle.dataset.labelClose || "Cerrar menú";

    function openMenu() {
      menu.classList.remove(...MENU_CLOSED);
      menu.classList.add(...MENU_OPEN);
      backdrop.classList.remove(...BACKDROP_CLOSED);
      backdrop.classList.add(...BACKDROP_OPEN);
      if (topLine) topLine.style.transform = "translateY(6px) rotate(45deg)";
      if (midLine) midLine.style.opacity = "0";
      if (botLine) botLine.style.transform = "translateY(-6px) rotate(-45deg)";
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", closeLabel);
      html.style.overflow = "hidden";
    }

    function closeMenu() {
      menu.classList.remove(...MENU_OPEN);
      menu.classList.add(...MENU_CLOSED);
      backdrop.classList.remove(...BACKDROP_OPEN);
      backdrop.classList.add(...BACKDROP_CLOSED);
      if (topLine) topLine.style.transform = "";
      if (midLine) midLine.style.opacity = "";
      if (botLine) botLine.style.transform = "";
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", openLabel);
      html.style.overflow = "";
    }

    toggle.addEventListener("click", () => {
      if (toggle.getAttribute("aria-expanded") === "true") {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn.addEventListener("click", closeMenu);
    backdrop.addEventListener("click", closeMenu);

    menu.querySelectorAll("a[href^='#']").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }

  const navLinks = document.querySelectorAll("nav a[href^='#']");
  const sections = [...navLinks].map((link) => document.getElementById(link.getAttribute("href")?.slice(1) || "")).filter(Boolean);

  const navObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            link.removeAttribute("aria-current");
            if (link.getAttribute("href") === `#${id}`) {
              link.setAttribute("aria-current", "section");
            }
          });
        }
      }
    },
    { threshold: 0.3, rootMargin: "-80px 0px 0px 0px" }
  );

  sections.forEach((s) => s && navObserver.observe(s));
</script>
