---
import { es } from "../i18n";

const { t = es } = Astro.props;
---

<section id="community" class="px-4 py-24">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-medieval text-3xl text-amber-400 md:text-4xl reveal">{t.community.title}</h2>
    <p class="mt-4 text-neutral-400 reveal reveal-delay-1">
      {t.community.description}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4 reveal reveal-delay-2">
      <a
        href="https://discord.gg/invite/battleforembolia"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-indigo-500 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-500/25"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
        Discord
      </a>
      <a
        href="https://www.youtube.com/c/AgerGames"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-red-500 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-red-500/25"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        YouTube / Ager Games
      </a>
      <a
        href="https://www.facebook.com/groups/battleforembolia/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-blue-500 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-blue-500/25"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Facebook
      </a>
      <a
        href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-neutral-700 px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-neutral-600 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-neutral-500/25"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.526 3.007 8.32 7.082 9.578.518.095.707-.225.707-.5 0-.247-.009-1.062-.014-1.924-2.88.626-3.487-1.246-3.487-1.246-.471-1.196-1.15-1.514-1.15-1.514-.94-.642.07-.63.07-.63 1.039.074 1.585 1.067 1.585 1.067.924 1.582 2.423 1.125 3.013.86.094-.669.362-1.125.658-1.384-2.3-.261-4.72-1.15-4.72-5.12 0-1.131.405-2.055 1.067-2.78-.107-.262-.462-1.315.1-2.74 0 0 .87-.279 2.85 1.062A9.95 9.95 0 0 1 12 7.39a9.94 9.94 0 0 1 2.595.349c1.98-1.34 2.85-1.062 2.85-1.062.562 1.425.207 2.478.1 2.74.662.725 1.067 1.65 1.067 2.78 0 3.978-2.423 4.855-4.73 5.112.372.32.703.954.703 1.924 0 1.388-.013 2.507-.013 2.85 0 .277.188.6.713.498A10.02 10.02 0 0 0 22 12Z"/></svg>
        Steam Community
      </a>
      <a
        href="https://agergames.com.ar"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-amber-700 px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-amber-600 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/25"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        Ager Games
      </a>
    </div>
    <div class="mt-8">
      <button
        data-copy-email
        class="text-sm text-neutral-500 underline underline-offset-4 hover:text-amber-400 transition-colors cursor-pointer"
        aria-label="Copiar correo"
      >
        agustin.figueroa.dev@gmail.com
      </button>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector("[data-copy-email]");
  if (btn) {
    btn.addEventListener("click", async () => {
      const email = btn.textContent?.trim();
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const orig = btn.textContent;
        btn.textContent = "✓ Copiado!";
        btn.classList.add("text-emerald-400");
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove("text-emerald-400");
        }, 2000);
      } catch {
        // fallback
        const ta = document.createElement("textarea");
        ta.value = email;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
      }
    });
  }
</script>
