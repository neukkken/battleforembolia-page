---
import { Image } from "astro:assets";
import bgImage from "../assets/images/hero/title1.jpg";
import logoImage from "../assets/images/titletext.png";
import itchBanner from "../assets/images/itch-banner.png";
import steamImage from "../assets/images/steamLink.png";
import itchAlpha from "../assets/images/itchAlpha.png";
import { es } from "../i18n";

const { t = es } = Astro.props;
---

<section id="hero" class="relative flex min-h-screen items-center justify-center overflow-hidden py-20">
  <div class="absolute inset-0">
    <Image
      src={bgImage}
      alt=""
      class="h-full w-full object-cover"
      loading="eager"
      formats={["avif", "webp", "jpeg"]}
      widths={[640, 1024, 1920]}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/70 via-neutral-950/60 to-neutral-950" />
  </div>
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
    <img
      src={logoImage.src}
      alt="Battle For Embolia"
      class="mx-auto h-auto w-full max-w-md md:max-w-xl animate-fade-in-down"
      loading="eager"
      style="animation-delay: 0.2s; opacity: 0; animation-fill-mode: forwards;"
    />
    <p
      class="mt-6 text-lg text-neutral-300 md:text-xl animate-fade-in-up"
      style="animation-delay: 0.6s; opacity: 0; animation-fill-mode: forwards;"
    >
      {t.hero.tagline}
    </p>
    <div data-buttons-pre class="mt-6 flex flex-wrap items-center justify-center gap-3 animate-fade-in-up" style="animation-delay: 1.3s; opacity: 0; animation-fill-mode: forwards;">
      <a
        href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-48 transition-all duration-300 hover:scale-105 hover:opacity-90"
      >
        <img src={steamImage.src} alt={t.hero.wishlist} class="w-full" />
      </a>
      <a
        href="https://agerarg.itch.io/battle-for-embolia"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-48 transition-all duration-300 hover:scale-105 hover:opacity-90"
      >
        <img src={itchAlpha.src} alt="Alpha Testing" class="w-full" />
      </a>
    </div>
    <div data-buttons-post class="mt-6 hidden flex-wrap items-center justify-center gap-3 animate-fade-in-up" style="animation-delay: 1.3s; opacity: 0; animation-fill-mode: forwards;">
      <div class="w-80">
        <div class="overflow-hidden rounded-t-xl border border-neutral-800">
          <img src={itchBanner.src} alt="Battle For Embolia" class="w-full" />
        </div>
        <div class="flex gap-2 rounded-b-xl border border-t-0 border-neutral-800 bg-neutral-900 p-4">
          <a
            href="https://store.steampowered.com/app/3462790/Battle_For_Embolia"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 flex items-center justify-center gap-2 rounded-lg bg-amber-500 px-3 py-3 font-bold text-neutral-950 transition-all hover:bg-amber-400 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/20"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/></svg>
            <span class="text-sm">Steam</span>
          </a>
          <a
            href="https://agerarg.itch.io/battle-for-embolia"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 flex items-center justify-center gap-2 rounded-lg border border-neutral-700 bg-neutral-800/50 px-3 py-3 text-sm font-semibold text-neutral-300 transition-all hover:border-amber-500/50 hover:text-amber-400 hover:-translate-y-0.5"
          >
            <svg width="16" height="16" viewBox="0 0 640 640" fill="currentColor"><path d="M135.9 98.8C114.2 111.7 71.4 160.8 71 173.7L71 195C71 222.1 96.3 245.8 119.2 245.8C146.8 245.8 169.7 223 169.7 195.8C169.7 222.9 191.9 245.8 219.5 245.8C247.1 245.8 268.5 223 268.5 195.8C268.5 222.9 292.1 245.8 319.7 245.8L320.2 245.8C347.8 245.8 371.4 223 371.4 195.8C371.4 222.9 392.9 245.8 420.4 245.8C447.9 245.8 470.2 223 470.2 195.8C470.2 222.9 493.2 245.8 520.7 245.8C543.7 245.8 569 222 569 195L569 173.7C568.6 160.8 525.8 111.6 504.1 98.7C436.7 96.4 389.9 96 320.1 96C250.3 96 155.1 97.1 135.9 98.8zM268.2 233.2C246.2 271.6 190.3 271.9 168.4 233.4C155.2 256.5 125.2 265.5 112.4 261.1C108.5 301.3 98.7 498.2 130.1 530.3C210.1 549 432.2 548.4 509.9 530.3C541.5 498 531.2 298.3 527.6 261.1C514.7 265.5 484.7 256.5 471.6 233.4C449.6 271.9 393.8 271.5 371.8 233.2C364.7 245.7 348.8 262.1 320 262.1C309.6 262.4 299.2 259.9 290.1 254.8C281 249.7 273.4 242.2 268.2 233.2L268.2 233.2zM226.6 287C243.1 287 257.7 287 275.8 306.8C305.1 303.8 334.7 303.8 364 306.8C382.2 287.1 396.8 287.1 413.2 287.1C465.5 287.1 478.4 364.6 497.1 431.5C514.4 493.7 491.6 495.2 463.1 495.2C421 493.6 397.6 463 397.6 432.4C358.3 438.8 295.7 441.2 242 432.4C242 463 218.7 493.6 176.5 495.2C148.1 495.1 125.3 493.6 142.6 431.5C161.3 364.5 174.2 287.1 226.5 287.1L226.5 287zM320 334.8C320 334.8 275.6 375.6 267.6 390L296.6 388.8L296.6 414.1C296.6 415.6 317.9 414.3 319.9 414.3C331.5 414.8 343.2 415.3 343.2 414.1L343.2 388.8L372.2 390C364.2 375.5 319.8 334.8 319.8 334.8L319.9 334.8z"/></svg>
            <span>Itch.io</span>
          </a>
        </div>
      </div>
    </div>
    <div data-release-wrapper>
      <div
        class="mx-auto mt-8 max-w-lg animate-fade-in-up"
        style="animation-delay: 1s; opacity: 0; animation-fill-mode: forwards;"
        data-countdown
      >
        <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 px-6 py-5 backdrop-blur-sm sm:px-10 sm:py-6">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-amber-400/80">
            {t.countdown.label}
          </p>
          <div class="flex items-center justify-center gap-3 sm:gap-5">
            <div class="flex flex-col items-center">
              <span class="font-medieval text-4xl text-white sm:text-5xl md:text-6xl" data-days>00</span>
              <span class="mt-1 text-[11px] uppercase tracking-widest text-neutral-500">{t.countdown.days}</span>
            </div>
            <span class="mb-5 text-2xl text-amber-400/60 sm:text-3xl md:text-4xl" data-colon>:</span>
            <div class="flex flex-col items-center">
              <span class="font-medieval text-4xl text-white sm:text-5xl md:text-6xl" data-hours>00</span>
              <span class="mt-1 text-[11px] uppercase tracking-widest text-neutral-500">{t.countdown.hours}</span>
            </div>
            <span class="mb-5 text-2xl text-amber-400/60 sm:text-3xl md:text-4xl" data-colon>:</span>
            <div class="flex flex-col items-center">
              <span class="font-medieval text-4xl text-white sm:text-5xl md:text-6xl" data-minutes>00</span>
              <span class="mt-1 text-[11px] uppercase tracking-widest text-neutral-500">{t.countdown.minutes}</span>
            </div>
            <span class="mb-5 text-2xl text-amber-400/60 sm:text-3xl md:text-4xl" data-colon>:</span>
            <div class="flex flex-col items-center">
              <span class="font-medieval text-4xl text-white sm:text-5xl md:text-6xl" data-seconds>00</span>
              <span class="mt-1 text-[11px] uppercase tracking-widest text-neutral-500">{t.countdown.seconds}</span>
            </div>
          </div>
        </div>
      </div>
      <div data-release-message class="mt-6 animate-fade-in sm:mt-8" style="animation-delay: 1.5s; opacity: 0; animation-fill-mode: forwards;">
        <p class="text-sm font-medium text-amber-400/70 sm:text-base" data-countdown-label>
          {t.hero.releaseDate}
        </p>
      </div>
    </div>
  </div>
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="h-6 w-6 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script define:vars={{ nowAvailable: t.nowAvailable }}>
  (function () {
    const target = new Date("2026-07-03T00:00:00").getTime();
    const wrapper = document.querySelector("[data-release-wrapper]");
    if (!wrapper) return;

    const el = wrapper.querySelector("[data-countdown]");
    const label = wrapper.querySelector("[data-countdown-label]");
    const message = wrapper.querySelector("[data-release-message]");
    if (!el || !label || !message) return;

    const daysEl = el.querySelector("[data-days]");
    const hoursEl = el.querySelector("[data-hours]");
    const minutesEl = el.querySelector("[data-minutes]");
    const secondsEl = el.querySelector("[data-seconds]");

    function pad(n) {
      return String(n).padStart(2, "0");
    }

    function triggerRelease() {
      if (el.dataset.released) return;
      el.dataset.released = "true";

      const groups = el.querySelectorAll("[data-days], [data-hours], [data-minutes], [data-seconds]");
      groups.forEach((g) => {
        const parent = g.closest<HTMLElement>(".flex-col");
        if (parent) {
          parent.style.transition = "all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)";
          parent.style.transform = "scale(1.2)";
          parent.style.opacity = "0";
        }
      });

      setTimeout(() => {
        el.querySelectorAll("[data-colon]").forEach(function(s) { s.style.display = "none"; });
        el.querySelectorAll(".flex-col").forEach(function(s) { s.style.display = "none"; });
        const lbl = el.querySelector("p");
        if (lbl) lbl.remove();
        const box = el.firstElementChild;
        if (box) {
          box.style.transition = "all 0.5s ease";
          box.style.padding = "0";
          box.style.border = "none";
          box.style.background = "none";
          box.style.backdropFilter = "none";
        }
      }, 500);

      setTimeout(() => {
        label.style.display = "none";
        message.style.opacity = "0";
        message.style.transform = "scale(0.8)";
        message.innerHTML = '<span class="inline-flex items-center gap-2 rounded-full bg-emerald-500/20 px-6 py-3 text-lg font-bold text-emerald-400 animate-scale-in"><span class="h-3 w-3 rounded-full bg-emerald-400 animate-pulse"></span> ' + nowAvailable + '</span>';
        requestAnimationFrame(() => {
          message.style.transition = "all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)";
          message.style.opacity = "1";
          message.style.transform = "scale(1)";
        });
      }, 700);

      const pre = document.querySelector("[data-buttons-pre]");
      const post = document.querySelector("[data-buttons-post]");
      if (pre) pre.classList.add("hidden");
      if (post) { post.classList.remove("hidden"); post.classList.add("flex"); }

      const headerCta = document.querySelector("[data-header-cta]");
      const footerBtns = document.querySelector("[data-footer-buttons]");
      const footerPost = document.querySelector("[data-footer-post]");
      if (headerCta) {
        headerCta.textContent = headerCta.dataset.textPost || headerCta.textContent;
      }
      if (footerBtns) footerBtns.classList.add("hidden");
      if (footerPost) { footerPost.classList.remove("hidden"); footerPost.classList.add("flex"); }
    }

    function tick() {
      const now = Date.now();
      const diff = target - now;

      if (diff <= 0) {
        triggerRelease();
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      daysEl.textContent = pad(days);
      hoursEl.textContent = pad(hours);
      minutesEl.textContent = pad(minutes);
      secondsEl.textContent = pad(seconds);
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>
