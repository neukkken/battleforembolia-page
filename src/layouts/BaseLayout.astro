---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: "es" | "en";
}

const {
  title = "Battle For Embolia — MMORPG indie gratuito",
  description = "Battle For Embolia es un MMORPG indie de acción con combate dinámico, progresión significativa y actualizaciones constantes. Gratuito, sin pay-to-win.",
  image = "/favicon.png",
  lang = "es",
} = Astro.props;

const locale = lang === "en" ? "en_US" : "es_ES";
const path = lang === "en" ? "/en/" : "/";
const hreflangs = [
  { lang: "es", href: "https://www.battleforembolia.com/" },
  { lang: "en", href: "https://www.battleforembolia.com/en/" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#030712" />
    <link rel="canonical" href={`https://www.battleforembolia.com${path}`} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href="https://www.battleforembolia.com/" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content="Battle For Embolia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AgerGames" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=MedievalSharp&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=MedievalSharp&display=swap" rel="stylesheet" /></noscript>

    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://flagcdn.com https://shared.akamai.steamstatic.com data:; frame-src https://www.youtube-nocookie.com; connect-src 'self'; media-src 'self';" />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "name": "Battle For Embolia",
        "description": description,
        "applicationCategory": "Game",
        "applicationSubCategory": "Early Access",
        "operatingSystem": "Windows",
        "genre": ["MMORPG", "Action", "RPG", "Free To Play"],
        "gamePlatform": ["Windows"],
        "author": {
          "@type": "Person",
          "name": "Agustín Figueroa",
          "sameAs": "https://agergames.com.ar"
        },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "releaseDate": "2026-07-03",
        "inLanguage": ["es", "en", "pt", "zh", "ja", "de", "ru", "ko", "ar"],
        "trailer": {
          "@type": "VideoObject",
          "name": "Battle For Embolia Trailer",
          "embedUrl": "https://www.youtube-nocookie.com/embed/CZse4Et9XfI"
        }
      })}
    </script>
  </head>
  <body class="bg-neutral-950 text-neutral-100 font-sans antialiased">
    <a href="#main-content" class="skip-link">{lang === "en" ? "Skip to main content" : "Ir al contenido principal"}</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<script>
  const observer = new IntersectionObserver(
    (entries: IntersectionObserverEntry[]) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => observer.observe(el));

  const header = document.querySelector<HTMLElement>("header");
  if (header) {
    let ticking = false;
    document.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          header.classList.toggle("scrolled", window.scrollY > 60);
          ticking = false;
        });
        ticking = true;
      }
    });
  }
</script>
